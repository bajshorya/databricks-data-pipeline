{
  "datasets": [
    {
      "name": "daily",
      "displayName": "Daily earnings",
      "queryLines": [
        "SELECT trip_date, earnings_per_minute_7day_avg FROM workspace.pipeline_gold.daily_summary"
      ]
    },
    {
      "name": "shifts",
      "displayName": "Best zones per shift",
      "queryLines": [
        "SELECT shift, zone, earnings_per_minute FROM workspace.pipeline_gold.shift_best_zones WHERE day_type = 'Weekday'"
      ]
    },
    {
      "name": "hours",
      "displayName": "Best zone per hour",
      "queryLines": [
        "SELECT pickup_hour, day_type, earnings_per_minute FROM workspace.pipeline_gold.zone_hour_earnings WHERE zone_rank = 1"
      ]
    },
    {
      "name": "airport",
      "displayName": "Airport vs city",
      "queryLines": [
        "SELECT month, pickup_type, earnings_per_minute FROM workspace.pipeline_gold.airport_vs_city"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Driver Shift Planner",
      "layout": [
        {
          "widget": {
            "name": "note",
            "multilineTextboxSpec": {
              "lines": [
                "# Where should a NYC cab driver work?\n",
                "\n",
                "Built from NYC TLC yellow taxi trips (Jan to Mar 2024) by the Databricks job (Bronze \u2192 Silver \u2192 Gold). Earnings = fare + tip, per minute on a trip. Cash tips aren't recorded and waiting time between trips isn't in the data, so this compares places and times; it isn't a driver's true hourly pay. Only zones averaging at least 1 pickup per hour are ranked; \"Outside of NYC\" and Newark (too few pickups) are left out."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "w1",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "shifts",
                  "fields": [
                    {
                      "name": "zone",
                      "expression": "`zone`"
                    },
                    {
                      "name": "earnings_per_minute",
                      "expression": "`earnings_per_minute`"
                    },
                    {
                      "name": "shift",
                      "expression": "`shift`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "zone",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "zone"
                },
                "y": {
                  "fieldName": "earnings_per_minute",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "earnings_per_minute"
                },
                "color": {
                  "fieldName": "shift",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "shift"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Weekdays: top 5 pickup zones per shift, earnings per minute ($)"
              },
              "mark": {
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "w2",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "hours",
                  "fields": [
                    {
                      "name": "pickup_hour",
                      "expression": "`pickup_hour`"
                    },
                    {
                      "name": "earnings_per_minute",
                      "expression": "`earnings_per_minute`"
                    },
                    {
                      "name": "day_type",
                      "expression": "`day_type`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "pickup_hour",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "pickup_hour"
                },
                "y": {
                  "fieldName": "earnings_per_minute",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "earnings_per_minute"
                },
                "color": {
                  "fieldName": "day_type",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "day_type"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Best zone's earnings per minute ($), by hour of pickup"
              },
              "mark": {
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 3,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "w3",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "airport",
                  "fields": [
                    {
                      "name": "pickup_type",
                      "expression": "`pickup_type`"
                    },
                    {
                      "name": "earnings_per_minute",
                      "expression": "`earnings_per_minute`"
                    },
                    {
                      "name": "month",
                      "expression": "`month`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "pickup_type",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "pickup_type"
                },
                "y": {
                  "fieldName": "earnings_per_minute",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "earnings_per_minute"
                },
                "color": {
                  "fieldName": "month",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "month"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Airport vs city pickups: earnings per minute ($), by month"
              },
              "mark": {
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 9,
            "width": 3,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "w4",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "trip_date",
                      "expression": "`trip_date`"
                    },
                    {
                      "name": "earnings_per_minute_7day_avg",
                      "expression": "`earnings_per_minute_7day_avg`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "trip_date",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "trip_date"
                },
                "y": {
                  "fieldName": "earnings_per_minute_7day_avg",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "earnings_per_minute_7day_avg"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "All drivers: earnings per minute ($), 7-day moving average"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 16,
            "width": 6,
            "height": 6
          }
        }
      ]
    }
  ]
}
